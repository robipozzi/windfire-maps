### 1. Copy this file
### 2. Rename as .env
### 3. Put the actual values of the following properties
# Google Maps API configuration
GOOGLE_MAPS_API_KEY=<your_actual_google_maps_api_key>
GOOGLE_MAPS_API_URL=https://maps.googleapis.com/maps/api
# SSL configuration
ENABLE_HTTPS=<true | false>
HTTP_PORT=<put HTTP port>
HTTPS_PORT=<put HTTPS port>
SSL_KEY_PATH=<put path to SSL key file>
SSL_CERT_PATH=<put path to certification authority cert file>
# API configuration
API_PREFIX=/v1